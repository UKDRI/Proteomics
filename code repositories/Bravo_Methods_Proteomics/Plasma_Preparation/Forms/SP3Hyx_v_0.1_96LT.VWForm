    <Object type="ToolboxLibrary.OperatorConsoleButton, Toolbox, Version=13.1.6.1422, Culture=neutral, PublicKeyToken=null" name="operatorConsoleButton4" children="Controls">
      <Property name="BackColor">240, 240, 240</Property>
      <Property name="Image">
        <Binary></Binary>
      </Property>
      <Property name="Text">Check values and Run SP3</Property>
      <Property name="TextImageRelation">ImageBeforeText</Property>
      <Property name="UseCompatibleTextRendering">True</Property>
      <Property name="UseVisualStyleBackColor">False</Property>
      <Property name="DataBindings">
        <Property name="DefaultDataSourceUpdateMode">OnValidation</Property>
      </Property>
      <Property name="Font">Tahoma, 12pt</Property>
      <Property name="ForeColor">0, 0, 0</Property>
      <Property name="Location">1088, 545</Property>
      <Property name="Name">operatorConsoleButton4</Property>
      <Property name="Size">239, 48</Property>
      <Property name="TabIndex">57</Property>
      <Parameter Name="Control name" Description="" Type="1" Value="operatorConsoleButton4" ValueToDisplay="" Hide_if="" />
      <Parameter Name="JavaScript variable" Description="The variable whose value is displayed in this field" Type="1" Value="" ValueToDisplay="" Hide_if="" />
      <Parameter Name="Always use global context" Description="If checked, the variable above will always be retrieved from the Global context" Type="0" Value="1" ValueToDisplay="" Hide_if="" />
      <Parameter Name="Default value" Description="The default value of the Javascript variable" Type="1" Value="" ValueToDisplay="" Hide_if="Variable(JavaScript variable) == Const(&quot;&quot;)" />
      <Parameter Name="Script" Description="The JavaScript to execute when this button is pressed" Type="31" Value="// set head and version&#xA;protocolVersion = &quot;0.1&quot;&#xA;formHeadType = &quot;96LT&quot;&#xA;&#xA;print(&quot;formFilePath = &quot; + formFilePath)&#xA;// find the last-but-one slash in the formFilePath &#xA;rootSlashIndex = formFilePath.lastIndexOf(&quot;/&quot;, formFilePath.lastIndexOf(&quot;/&quot;)-1) &#xA;scriptsPath = formFilePath.slice(0,rootSlashIndex) + &quot;/Scripts/&quot;&#xA;protocolPath = formFilePath.slice(0,rootSlashIndex) + &quot;/Protocols/&quot;&#xA;&#xA;// Removed 1.0RC -- there is not form name anymore in formFilePath, only path.&#xA;//formName = formFilePath.substring(formFilePath.lastIndexOf(&quot;/&quot;)+1)&#xA;&#xA;// building formName from the parameters above &#xA;formName = &quot;SP3Hyx_v_&quot; + protocolVersion +&quot;_&quot;+formHeadType+&quot;.VWForm&quot;&#xA;print(&quot;formName = &quot; + formName)&#xA;&#xA;print(&quot;scriptsPath = &quot; + scriptsPath)&#xA;&#xA;open(scriptsPath + &quot;alert.js&quot;)&#xA;open(scriptsPath + &quot;beadsPlateColsCheck.js&quot;)&#xA;&#xA;// labware data retrieval just in case&#xA;open(scriptsPath + &quot;getPlateData.js&quot;)&#xA;print(&quot;labwareDataRetrievedOK = &quot; + labwareDataRetrievedOK)&#xA;&#xA;// run this again just in case&#xA;open(scriptsPath + &quot;formVolFuncs.js&quot;)&#xA;volumesCalculatedOK = formCalcVols()&#xA;print(&quot;volumesCalculatedOK = &quot; + volumesCalculatedOK)&#xA;&#xA;// if this variables does not exist, set it to false&#xA;labwareDataRetrievedOK = labwareDataRetrievedOK || false&#xA;&#xA;if (!volumesCalculatedOK) {&#xA;   formInfo = &quot;Errors found when calculating volumes. Can't proceed.&quot;&#xA;   alert()&#xA;}&#xA;else if (!labwareDataRetrievedOK) {&#xA;   formInfo = &quot;Error found when retrieving labware data. Can't proceed.&quot;&#xA;   alert()&#xA;}&#xA;else if (!beadsPlateColsCheck()) {&#xA;   formInfo = &quot;Duplicate columns in bead plate. Can't proceed.&quot;&#xA;   alert()&#xA;}&#xA;else if (! (statusColsString = statusColsString || false)) {&#xA;   formInfo = &quot;Tips status not set. Can't proceed.&quot;&#xA;   alert()&#xA;}&#xA;else {&#xA;   protFilePath = protocolPath + &quot;SP3Hyx_&quot;+formHeadType+&quot;_v_&quot;+protocolVersion+&quot;.pro&quot;&#xA;   formInfo = &quot;Starting &quot; + protFilePath&#xA;   tipsStatusChangeEnabled = false&#xA;   runset.clear()&#xA;   runset.appendProtocolFileToRunset(protFilePath, 1, &quot;&quot;, formName)&#xA;   print(&quot;Running &quot; + protFilePath + &quot; using form &quot; + formName)&#xA;}&#xA;" ValueToDisplay="" Hide_if="" />
      <Parameter Name="Icon" Description="A graphical image file to display in the button" Type="9" Value="C:\VWorks Workspace\SP3\Forms\24b_start_icon_up.ico" ValueToDisplay="Image Files(*.jpg;*.png;*.bmp;*.ico)|*.jpg;*.png;*.bmp;*.ico||" Hide_if="" />
      <Parameter Name="Disable when running" Description="the button is disabled whenever a protocol is running" Type="0" Value="1" ValueToDisplay="" Hide_if="" />
      <Parameter Name="Caption" Description="The string to display in the button" Type="1" Value="Check values and Run SP3" ValueToDisplay="" Hide_if="" />
      <Parameter Name="Font size" Description="The point size of the font used to display text in this field" Type="8" Value="12" ValueToDisplay="" Hide_if="">
        <Ranges>
          <Range Value="1" />
          <Range Value="72" />
        </Ranges>
      </Parameter>
      <Parameter Name="Font color" Description="The color of the font used to display text in this field" Type="32" Value="0" ValueToDisplay="" Hide_if="" />
      <Parameter Name="Background color" Description="The color of this button's background" Type="32" Value="15790320" ValueToDisplay="" Hide_if="" />
    </Object>
