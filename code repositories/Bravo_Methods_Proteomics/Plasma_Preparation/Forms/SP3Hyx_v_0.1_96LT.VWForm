        <Parameter Name="Script" Description="The JavaScript to execute when this button is pressed" Type="31" Value="print(&quot;formFilePath = &quot; + formFilePath)&#xA;// find the last-but-one slash in the formFilePath &#xA;rootSlashIndex = formFilePath.lastIndexOf(&quot;/&quot;, formFilePath.lastIndexOf(&quot;/&quot;)-1) &#xA;scriptsPath = formFilePath.slice(0,rootSlashIndex) + &quot;/Scripts/&quot;&#xA;print(&quot;scriptsPath = &quot; + scriptsPath)&#xA;open(scriptsPath + &quot;formTipsFuncs.js&quot;)&#xA;open(scriptsPath + &quot;alert.js&quot;)&#xA;&#xA;&#xA;// this comes from the protocol&#xA;// if it does not exist it will be false&#xA;tipsStatusChangeEnabled = tipsStatusChangeEnabled || false&#xA;&#xA;// proceed only if allowed by protocol &#xA;if (tipsStatusChangeEnabled) {&#xA;   statusColsString = &quot;E,E,E,E,E,E,E,E,E,E,E,E&quot;&#xA;   colsFormUpdate2()&#xA;}&#xA;else {&#xA;   formInfo =  &quot;Please enable tips status change first!&quot;&#xA;   alert()&#xA;}&#xA;&#xA;print(statusColsString)&#xA;" ValueToDisplay="" Hide_if="" />
