      <Object type="ToolboxLibrary.OperatorConsoleButton, Toolbox, Version=13.1.6.1422, Culture=neutral, PublicKeyToken=null" name="operatorConsoleButton12" children="Controls">
        <Property name="BackColor">104, 131, 139</Property>
        <Property name="Text">Calculate TFA vol</Property>
        <Property name="TextImageRelation">ImageBeforeText</Property>
        <Property name="UseCompatibleTextRendering">True</Property>
        <Property name="UseVisualStyleBackColor">False</Property>
        <Property name="DataBindings">
          <Property name="DefaultDataSourceUpdateMode">OnValidation</Property>
        </Property>
        <Property name="Font">Tahoma, 10pt</Property>
        <Property name="ForeColor">255, 255, 255</Property>
        <Property name="Location">498, 427</Property>
        <Property name="Name">operatorConsoleButton12</Property>
        <Property name="Size">125, 28</Property>
        <Property name="TabIndex">65</Property>
        <Parameter Name="Control name" Description="" Type="1" Value="operatorConsoleButton12" ValueToDisplay="" Hide_if="" />
        <Parameter Name="JavaScript variable" Description="The variable whose value is displayed in this field" Type="1" Value="" ValueToDisplay="" Hide_if="" />
        <Parameter Name="Always use global context" Description="If checked, the variable above will always be retrieved from the Global context" Type="0" Value="1" ValueToDisplay="" Hide_if="" />
        <Parameter Name="Default value" Description="The default value of the Javascript variable" Type="1" Value="" ValueToDisplay="" Hide_if="Variable(JavaScript variable) == Const(&quot;&quot;)" />
        <Parameter Name="Script" Description="The JavaScript to execute when this button is pressed" Type="31" Value="print(&quot;formFilePath = &quot; + formFilePath)&#xA;// find the last-but-one slash in the formFilePath &#xA;rootSlashIndex = formFilePath.lastIndexOf(&quot;/&quot;, formFilePath.lastIndexOf(&quot;/&quot;)-1) &#xA;scriptsPath = formFilePath.slice(0,rootSlashIndex) + &quot;/Scripts/&quot;&#xA;print(&quot;scriptsPath = &quot; + scriptsPath)&#xA;&#xA;open(scriptsPath + &quot;alert.js&quot;)&#xA;&#xA;if ( stockTFA &lt;= 0 || stockTFA &gt; 50 || stockTFA &lt;= finalPercTFA ) {&#xA;   formInfo = &quot;Error in input TFA concs. Can't calculate&quot;&#xA;   alert()&#xA;}&#xA;else {&#xA;   volTFA = Math.round( 10*finalPercTFA * (volABC + volTrypsin) / (stockTFA - finalPercTFA))/10&#xA;}&#xA;" ValueToDisplay="" Hide_if="" />
        <Parameter Name="Icon" Description="A graphical image file to display in the button" Type="9" Value="" ValueToDisplay="Image Files(*.jpg;*.png;*.bmp;*.ico)|*.jpg;*.png;*.bmp;*.ico||" Hide_if="" />
        <Parameter Name="Disable when running" Description="the button is disabled whenever a protocol is running" Type="0" Value="1" ValueToDisplay="" Hide_if="" />
        <Parameter Name="Caption" Description="The string to display in the button" Type="1" Value="Calculate TFA vol" ValueToDisplay="" Hide_if="" />
        <Parameter Name="Font size" Description="The point size of the font used to display text in this field" Type="8" Value="10" ValueToDisplay="" Hide_if="">
          <Ranges>
            <Range Value="1" />
            <Range Value="72" />
          </Ranges>
        </Parameter>
        <Parameter Name="Font color" Description="The color of the font used to display text in this field" Type="32" Value="16777215" ValueToDisplay="" Hide_if="" />
        <Parameter Name="Background color" Description="The color of this button's background" Type="32" Value="9143144" ValueToDisplay="" Hide_if="" />
      </Object>
